<Application x:Class="Mode22.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utility="clr-namespace:Mode22.Utility"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
                <ResourceDictionary Source="Themes/Strings.En.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <utility:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <utility:StringToVisibilityConverter x:Key="StringToVisibility" />
            <utility:NullToVisibilityConverter x:Key="NullToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
