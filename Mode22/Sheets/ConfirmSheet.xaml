<UserControl x:Class="Mode22.Sheets.ConfirmSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <Border Width="424"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="44"
                              Direction="270"
                              Opacity="0.28"
                              ShadowDepth="12"
                              Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="26,24,26,22">
            <Border Width="44"
                    Height="44"
                    CornerRadius="12"
                    Background="{DynamicResource DangerSoftBrush}"
                    HorizontalAlignment="Left">
                <Path Data="{StaticResource IconAlert}"
                      Style="{StaticResource LineIcon}"
                      Width="20"
                      Height="20"
                      Stroke="{DynamicResource DangerBrush}"
                      StrokeThickness="1.7" />
            </Border>

            <TextBlock x:Name="TitleText"
                       Style="{StaticResource TextSheetTitle}"
                       Margin="0,16,0,0"
                       Text="Удалить сценарий?" />
            <TextBlock x:Name="MessageText"
                       Style="{StaticResource TextSecondary}"
                       Margin="0,7,0,0"
                       TextWrapping="Wrap"
                       LineHeight="19" />

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        Content="Отмена"
                        Click="Cancel_Click" />
                <Button x:Name="ConfirmButton"
                        Grid.Column="2"
                        Style="{StaticResource DangerButton}"
                        Height="38"
                        MinWidth="108"
                        Content="Удалить"
                        Click="Confirm_Click" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
