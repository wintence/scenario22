<UserControl x:Class="Mode22.Sheets.ScenarioSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Mode22.Controls"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <Border Width="540"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="44"
                              Direction="270"
                              Opacity="0.28"
                              ShadowDepth="12"
                              Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="26,24,26,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="PreviewTile"
                        Width="46"
                        Height="46"
                        CornerRadius="13"
                        Background="{DynamicResource AccentStaticBrush}"
                        VerticalAlignment="Top">
                    <Grid>
                        <Path x:Name="PreviewTileIcon"
                              Style="{StaticResource LineIcon}"
                              Width="22"
                              Height="22"
                              Stroke="{DynamicResource TextOnAccentBrush}"
                              StrokeThickness="1.7" />
                        <Image x:Name="PreviewTileImage"
                               Width="30"
                               Height="30"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource TextSheetTitle}"
                               Text="Новый сценарий" />
                    <TextBlock Style="{StaticResource TextSecondary}"
                               Margin="0,3,0,0"
                               Text="Название, настроение и горячая клавиша" />
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        ToolTip="Закрыть"
                        Click="Cancel_Click"
                        VerticalAlignment="Top">
                    <Path Data="{StaticResource IconClose}"
                          Style="{StaticResource LineIcon}"
                          Width="15"
                          Height="15" />
                </Button>
            </Grid>

            <TextBlock Style="{StaticResource FormLabel}" Margin="0,18,0,7" Text="Название" />
            <TextBox x:Name="NameBox"
                     Style="{StaticResource InputTextBox}"
                     MaxLength="42"
                     Tag="Например, «Игровой режим»" />

            <TextBlock Style="{StaticResource FormLabel}" Margin="0,13,0,7" Text="Описание" />
            <TextBox x:Name="DescriptionBox"
                     Style="{StaticResource InputTextBox}"
                     MaxLength="90"
                     Tag="Что делает этот сценарий?" />

            <Grid Margin="0,13,0,7">
                <TextBlock Style="{StaticResource FormLabel}" Text="Иконка" />
                <Button Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right"
                        Margin="0,-6,0,0"
                        Padding="10,0"
                        Height="26"
                        ToolTip="Выбрать своё изображение (png, ico, exe)"
                        Click="CustomIcon_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolder}"
                              Style="{StaticResource LineIcon}"
                              Width="12"
                              Height="12"
                              Margin="0,0,6,0" />
                        <TextBlock FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   Text="Своё изображение…" />
                    </StackPanel>
                </Button>
            </Grid>
            <ListBox x:Name="IconListBox"
                     Style="{StaticResource HiddenListBox}"
                     SelectionChanged="Selection_Changed"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Path Data="{Binding Geometry}"
                              Style="{StaticResource LineIcon}"
                              Width="17"
                              Height="17"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1.7"
                              ToolTip="{Binding Name}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Margin" Value="0,0,3,3" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="11">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentStaticSoftBrush}" />
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentStaticBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Grid Margin="0,13,0,7">
                <TextBlock Style="{StaticResource FormLabel}" Text="Цвет сценария" />
                <Button Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right"
                        Margin="0,-6,0,0"
                        Padding="10,0"
                        Height="26"
                        ToolTip="Задать первый и второй цвет своего градиента"
                        Click="CustomColor_Click">
                    <TextBlock FontFamily="{StaticResource AppFontFamily}"
                               FontSize="11.5"
                               FontWeight="Medium"
                               Text="Свой цвет…" />
                </Button>
            </Grid>
            <ListBox x:Name="AccentListBox"
                     Style="{StaticResource HiddenListBox}"
                     Height="40"
                     SelectionChanged="Selection_Changed">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Ellipse Width="26" Height="26" Fill="{Binding PreviewBrush}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Margin" Value="0,0,3,0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="ToolTip" Value="{Binding Name}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1.5"
                                            CornerRadius="20">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ChipBorderBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <TextBlock Style="{StaticResource FormLabel}" Margin="0,13,0,7" Text="Горячая клавиша" />
            <controls:HotkeyBox x:Name="HotkeyInput" />
            <TextBlock Style="{StaticResource FormHint}"
                       Text="Работает в любом приложении, даже если Mode22 свёрнут в трей." />

            <Border x:Name="ErrorBanner"
                    Margin="0,12,0,0"
                    Padding="11,8"
                    Background="{DynamicResource DangerSoftBrush}"
                    CornerRadius="9"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource IconAlert}"
                          Style="{StaticResource LineIcon}"
                          Width="14"
                          Height="14"
                          Stroke="{DynamicResource DangerBrush}"
                          VerticalAlignment="Top"
                          Margin="0,1,7,0" />
                    <TextBlock x:Name="ErrorText"
                               Grid.Column="1"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="11.5"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="DeleteButton"
                        Style="{StaticResource GhostButton}"
                        Foreground="{DynamicResource DangerBrush}"
                        HorizontalAlignment="Left"
                        Click="Delete_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconTrash}"
                              Style="{StaticResource LineIcon}"
                              Width="14"
                              Height="14"
                              Stroke="{DynamicResource DangerBrush}"
                              Margin="0,0,6,0" />
                        <TextBlock FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Text="Удалить" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        Content="Отмена"
                        Click="Cancel_Click" />
                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Style="{StaticResource PrimaryButton}"
                        Height="38"
                        MinWidth="112"
                        Content="Сохранить"
                        Click="Save_Click" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
