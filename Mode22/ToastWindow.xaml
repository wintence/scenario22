<Window x:Class="Mode22.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mode22 toast"
        Width="388"
        Height="116"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource AppFontFamily}">
    <Grid x:Name="AnimRoot" Margin="14" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="16" />
        </Grid.RenderTransform>

        <Border x:Name="Shell"
                Background="{DynamicResource ToastBackgroundBrush}"
                BorderBrush="{DynamicResource ToastBorderBrush}"
                BorderThickness="1"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34"
                                  Direction="270"
                                  Opacity="0.35"
                                  ShadowDepth="9"
                                  Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="15,13,15,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconTile"
                            Width="44"
                            Height="44"
                            CornerRadius="13"
                            Background="{DynamicResource AccentStaticBrush}"
                            VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="EmojiText"
                                       FontFamily="{StaticResource EmojiFontFamily}"
                                       FontSize="21"
                                       Text="⚡"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Path x:Name="GlyphIcon"
                                  Style="{StaticResource LineIcon}"
                                  Width="19"
                                  Height="19"
                                  Stroke="{DynamicResource ToastPrimaryTextBrush}"
                                  StrokeThickness="1.7"
                                  Visibility="Collapsed" />
                            <Image x:Name="CustomIcon"
                                   Width="30"
                                   Height="30"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,10,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ToastPrimaryTextBrush}"
                                   Text="Игровой режим"
                                   TextTrimming="CharacterEllipsis"
                                   TextOptions.TextFormattingMode="Display" />
                        <TextBlock x:Name="SubtitleText"
                                   Margin="0,3,0,0"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource ToastSecondaryTextBrush}"
                                   Text="Выполняю сценарий…"
                                   TextTrimming="CharacterEllipsis"
                                   TextOptions.TextFormattingMode="Display" />
                    </StackPanel>

                    <Grid Grid.Column="2"
                          Width="24"
                          Height="24"
                          VerticalAlignment="Center">
                        <Path x:Name="Spinner"
                              Data="M 12,2 A 10,10 0 1 1 2,12"
                              Width="21"
                              Height="21"
                              Stroke="{DynamicResource ToastPrimaryTextBrush}"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              Stretch="Uniform"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation" />
                            </Path.RenderTransform>
                        </Path>

                        <Border x:Name="SuccessIcon"
                                Width="22"
                                Height="22"
                                CornerRadius="11"
                                Background="{DynamicResource SuccessBrush}"
                                Visibility="Collapsed">
                            <Path Data="{StaticResource IconCheck}"
                                  Width="12"
                                  Height="12"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform" />
                        </Border>

                        <Path x:Name="ErrorIcon"
                              Data="{StaticResource IconAlert}"
                              Width="22"
                              Height="22"
                              Stroke="{DynamicResource WarningBrush}"
                              StrokeThickness="1.9"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <Border Grid.Row="1"
                        Height="3"
                        Margin="15,0,15,10"
                        Background="{DynamicResource ToastTrackBrush}"
                        CornerRadius="2">
                    <Border x:Name="ProgressFill"
                            Background="{DynamicResource AccentStaticBrush}"
                            CornerRadius="2"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
