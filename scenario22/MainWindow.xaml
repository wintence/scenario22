<Window x:Class="Scenario22.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Scenario22.Models"
        Title="scenario22"
        Width="980"
        Height="730"
        MinWidth="980"
        MinHeight="700"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="Assets/app.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="7"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="PageScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="ScenarioListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="SidebarNavButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarItemSelectedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LinkRowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="ActionRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Margin" Value="8,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ActionTemplate">
            <Border Style="{StaticResource ActionRow}"
                    MouseLeftButtonUp="ActionRow_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconTile"
                            Width="40"
                            Height="40"
                            CornerRadius="0"
                            Background="{DynamicResource LaunchChipBgBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <Grid>
                            <Path x:Name="FallbackIcon"
                                  Data="{StaticResource IconArrowUpRight}"
                                  Style="{StaticResource LineIcon}"
                                  Width="17"
                                  Height="17"
                                  Stroke="{DynamicResource LaunchChipTextBrush}"
                                  StrokeThickness="1.8" />
                            <Image Source="{Binding IconSource}"
                                   Width="26"
                                   Height="26"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border x:Name="TypeChip"
                                    Margin="8,0,0,0"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource LaunchChipBgBrush}"
                                    CornerRadius="0">
                                <TextBlock x:Name="TypeText"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource LaunchChipTextBrush}"
                                           Text="{DynamicResource L_TypeLaunchBadge}" />
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Subtitle}"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <Path Data="{StaticResource IconClock}"
                                      Style="{StaticResource LineIcon}"
                                      Width="10"
                                      Height="10"
                                      Stroke="{DynamicResource TextTertiaryBrush}"
                                      StrokeThickness="1.8"
                                      Margin="0,0,4,0" />
                                <TextBlock Text="{Binding DelayLabel}"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <Button Style="{StaticResource SmallIconButton}"
                                Width="25"
                                Height="25"
                                ToolTip="{DynamicResource L_RowUpTT}"
                                Click="MoveActionUp_Click">
                            <Path Data="{StaticResource IconChevronUp}"
                                  Style="{StaticResource LineIcon}"
                                  Width="11"
                                  Height="11"
                                  Stroke="{DynamicResource TextTertiaryBrush}"
                                  StrokeThickness="1.9" />
                        </Button>
                        <Button Style="{StaticResource SmallIconButton}"
                                Width="25"
                                Height="25"
                                ToolTip="{DynamicResource L_RowDownTT}"
                                Click="MoveActionDown_Click">
                            <Path Data="{StaticResource IconChevronDown}"
                                  Style="{StaticResource LineIcon}"
                                  Width="11"
                                  Height="11"
                                  Stroke="{DynamicResource TextTertiaryBrush}"
                                  StrokeThickness="1.9" />
                        </Button>
                        <CheckBox Style="{StaticResource Switch}"
                                  Margin="8,0,8,0"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{DynamicResource L_RowSwitchTT}" />
                        <Button Style="{StaticResource DangerIconButton}"
                                Width="25"
                                Height="25"
                                ToolTip="{DynamicResource L_RowDelTT}"
                                Click="DeleteAction_Click">
                            <Path Data="{StaticResource IconTrash}"
                                  Style="{StaticResource LineIcon}"
                                  Width="12"
                                  Height="12"
                                  Stroke="{DynamicResource TextTertiaryBrush}"
                                  StrokeThickness="1.7" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ActionKind.Close}">
                    <Setter TargetName="TypeChip" Property="Background" Value="{DynamicResource CloseChipBgBrush}" />
                    <Setter TargetName="TypeText" Property="Foreground" Value="{DynamicResource CloseChipTextBrush}" />
                    <Setter TargetName="TypeText" Property="Text" Value="{DynamicResource L_TypeCloseBadge}" />
                    <Setter TargetName="IconTile" Property="Background" Value="{DynamicResource CloseChipBgBrush}" />
                    <Setter TargetName="FallbackIcon" Property="Data" Value="{StaticResource IconClose}" />
                    <Setter TargetName="FallbackIcon" Property="Stroke" Value="{DynamicResource CloseChipTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ActionKind.Music}">
                    <Setter TargetName="TypeText" Property="Text" Value="{DynamicResource L_TypeMusicBadge}" />
                    <Setter TargetName="FallbackIcon" Property="Data" Value="{StaticResource IconMusic}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ActionKind.YouTube}">
                    <Setter TargetName="TypeText" Property="Text" Value="{DynamicResource L_TypeYouTubeBadge}" />
                    <Setter TargetName="FallbackIcon" Property="Data" Value="{StaticResource IconYouTube}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ActionKind.Wallpaper}">
                    <Setter TargetName="TypeText" Property="Text" Value="{DynamicResource L_TypeWallpaperBadge}" />
                    <Setter TargetName="FallbackIcon" Property="Data" Value="{StaticResource IconImage}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ActionKind.Theme}">
                    <Setter TargetName="TypeText" Property="Text" Value="{DynamicResource L_TypeThemeBadge}" />
                    <Setter TargetName="FallbackIcon" Property="Data" Value="{StaticResource IconMoon}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootVisual">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="Topbar"
              Grid.Row="0"
              Background="Transparent"
              MouseLeftButtonDown="Topbar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="22,0,0,0">
                <Button Style="{StaticResource TrafficLightButton}"
                        Background="#FF5F57"
                        ToolTip="{DynamicResource L_CloseWinTT}"
                        Click="CloseButton_Click">
                    <Path Data="M 1,1 L 7,7 M 7,1 L 1,7"
                          Width="7"
                          Height="7"
                          Stroke="#72000000"
                          StrokeThickness="1.25"
                          StrokeStartLineCap="Flat"
                          StrokeEndLineCap="Flat"
                          Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource TrafficLightButton}"
                        Background="#FEBC2E"
                        ToolTip="{DynamicResource L_MinWinTT}"
                        Click="MinimizeButton_Click">
                    <Path Data="M 1,4 L 7,4"
                          Width="7"
                          Height="7"
                          Stroke="#72000000"
                          StrokeThickness="1.25"
                          StrokeStartLineCap="Flat"
                          StrokeEndLineCap="Flat"
                          Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource TrafficLightButton}"
                        Background="#28C840"
                        ToolTip="{DynamicResource L_MaxWinTT}"
                        Click="MaximizeButton_Click">
                    <Path Data="M 1.5,4 L 6.5,4 M 4,1.5 L 4,6.5"
                          Width="7"
                          Height="7"
                          Stroke="#72000000"
                          StrokeThickness="1.25"
                          StrokeStartLineCap="Flat"
                          StrokeEndLineCap="Flat"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="104,0,0,0"
                        IsHitTestVisible="False">
                <TextBlock Text="scenario22"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="15.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="1"
                    x:Name="HotkeyStatusButton"
                    Style="{StaticResource SecondaryButton}"
                    Height="30"
                    Padding="11,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0"
                    Click="OpenSettings_Click"
                    ToolTip="{DynamicResource L_OpenSettingsTT}">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="6"
                               Height="6"
                               Fill="{Binding HotkeyStatusBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0" />
                    <TextBlock Text="{Binding HotkeyStatusLabel}"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Sidebar and workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource SidebarBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="20,14,15,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource L_ScenariosHdr}"
                                   Style="{StaticResource TextSectionLabel}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SmallIconButton}"
                                Width="27"
                                Height="27"
                                ToolTip="{DynamicResource L_NewScenario}"
                                Click="NewScenario_Click">
                            <Path Data="{StaticResource IconPlus}"
                                  Style="{StaticResource LineIcon}"
                                  Width="13"
                                  Height="13"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.7" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="10,3,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="ScenarioListBox"
                                 Style="{StaticResource ScenarioListBoxStyle}"
                                 ItemsSource="{Binding Scenarios}"
                                 SelectedItem="{Binding SelectedScenario, Mode=TwoWay}"
                                 SelectionChanged="ScenarioList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ScenarioListItem}" />
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="36"
                                                Height="36"
                                                CornerRadius="0"
                                                Background="{Binding AccentSoftBrush}">
                                            <Grid>
                                                <Path Data="{Binding TileGeometry}"
                                                      Style="{StaticResource LineIcon}"
                                                      Width="17"
                                                      Height="17"
                                                      Stroke="{DynamicResource TextPrimaryBrush}"
                                                      StrokeThickness="1.7"
                                                      Visibility="{Binding TileIsImage, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                <Image Source="{Binding TileImage}"
                                                       Width="24"
                                                       Height="24"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding TileIsImage, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="10,0,4,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{StaticResource AppFontFamily}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding HotkeyDisplay}"
                                                       Margin="0,2,0,0"
                                                       FontFamily="{StaticResource AppFontFamily}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Path Grid.Column="2"
                                              Data="{StaticResource IconAlert}"
                                              Style="{StaticResource LineIcon}"
                                              Width="13"
                                              Height="13"
                                              Stroke="{DynamicResource WarningBrush}"
                                              StrokeThickness="1.8"
                                              VerticalAlignment="Center"
                                              ToolTip="{Binding HotkeyError}"
                                              Visibility="{Binding HasHotkeyError, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Row="1"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Margin="0,5,0,2"
                                Padding="11,0"
                                Click="NewScenario_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlus}"
                                      Style="{StaticResource LineIcon}"
                                      Width="12"
                                      Height="12"
                                      Stroke="{DynamicResource TextTertiaryBrush}"
                                      StrokeThickness="1.8"
                                      Margin="0,0,7,0" />
                                <TextBlock Text="{DynamicResource L_NewScenario}"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="10,8,10,13">
                        <Button x:Name="SettingsNavButton"
                                Style="{StaticResource SidebarNavButton}"
                                Click="OpenSettings_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconSliders}"
                                      Style="{StaticResource LineIcon}"
                                      Width="15"
                                      Height="15"
                                      Margin="0,0,9,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource L_SettingsNav}"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           FontSize="12.5"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Path Grid.Column="2"
                                      Data="{StaticResource IconChevronRight}"
                                      Style="{StaticResource LineIcon}"
                                      Width="11"
                                      Height="11"
                                      Stroke="{DynamicResource TextTertiaryBrush}"
                                      StrokeThickness="1.7" />
                            </Grid>
                        </Button>
                        <TextBlock x:Name="VersionText"
                                   Text="scenario22 · 1.0"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Opacity="0.7" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="Transparent">
                <ScrollViewer x:Name="ScenarioScrollViewer"
                              Style="{StaticResource PageScrollViewer}"
                              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <Grid>
                        <StackPanel x:Name="NoScenarioPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="40,120,40,40"
                                    Visibility="{Binding SelectedScenario, Converter={StaticResource NullToVisibility}}">
                            <Border Width="76"
                                    Height="76"
                                    CornerRadius="0"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource AccentStaticSoftBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1">
                                <Path Data="{StaticResource IconBolt}"
                                      Width="30"
                                      Height="30"
                                      Fill="{DynamicResource AccentStaticBrush}"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{DynamicResource L_EmptyTitle}"
                                       Style="{StaticResource TextPageTitle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,22,0,0" />
                            <TextBlock Text="{DynamicResource L_EmptyText}"
                                       Style="{StaticResource TextSecondary}"
                                       MaxWidth="380"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,8,0,0" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    MinWidth="170"
                                    Margin="0,22,0,0"
                                    HorizontalAlignment="Center"
                                    Click="NewScenario_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}"
                                          Style="{StaticResource PrimaryIcon}"
                                          Stroke="{DynamicResource TextOnAccentBrush}"
                                          StrokeThickness="1.8"
                                          Fill="Transparent"
                                          Width="14"
                                          Height="14"
                                          Margin="0,0,7,0" />
                                    <TextBlock Text="{DynamicResource L_NewScenario}"
                                               FontFamily="{StaticResource AppFontFamily}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnAccentBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="ScenarioPageContent"
                                    Margin="34,20,34,30"
                                    Visibility="{Binding SelectedScenario, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Border Width="66"
                                            Height="66"
                                            CornerRadius="0"
                                            Background="{Binding SelectedScenario.AccentGradient}"
                                            VerticalAlignment="Top">
                                        <Border BorderBrush="#2EFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="0">
                                            <Grid>
                                                <Path Data="{Binding SelectedScenario.TileGeometry}"
                                                      Style="{StaticResource LineIcon}"
                                                      Width="27"
                                                      Height="27"
                                                      Stroke="{DynamicResource TextOnAccentBrush}"
                                                      StrokeThickness="1.7"
                                                      Visibility="{Binding SelectedScenario.TileIsImage, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                <Image Source="{Binding SelectedScenario.TileImage}"
                                                       Width="40"
                                                       Height="40"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding SelectedScenario.TileIsImage, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                    </Border>

                                    <StackPanel Margin="16,0,0,0"
                                                VerticalAlignment="Center"
                                                MaxWidth="470">
                                        <TextBlock Text="{Binding SelectedScenario.Name}"
                                                   Style="{StaticResource TextPageTitle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedScenario.Description}"
                                                   Style="{StaticResource TextSecondary}"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap"
                                                   LineHeight="19" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="18,0,0,0">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Width="44"
                                            Height="46"
                                            Padding="0"
                                            Margin="0,0,9,0"
                                            ToolTip="{DynamicResource L_EditScenarioTT}"
                                            Click="EditScenario_Click">
                                        <Path Data="{StaticResource IconPencil}"
                                              Style="{StaticResource LineIcon}"
                                              Width="16"
                                              Height="16"
                                              Stroke="{DynamicResource TextSecondaryBrush}"
                                              StrokeThickness="1.7" />
                                    </Button>

                                    <Button x:Name="RunButton"
                                            Style="{StaticResource PrimaryButton}"
                                            MinWidth="142"
                                            Background="{Binding SelectedScenario.AccentGradient}"
                                            Click="RunSelected_Click">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedScenario.IsRunning}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Path Data="{StaticResource IconPlay}"
                                                      Style="{StaticResource PrimaryIcon}"
                                                      Width="14"
                                                      Height="14"
                                                      Margin="0,1,8,0" />
                                                <TextBlock Text="{DynamicResource L_Run}"
                                                           FontFamily="{StaticResource AppFontFamily}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextOnAccentBrush}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedScenario.IsRunning}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{DynamicResource L_Running}"
                                                           FontFamily="{StaticResource AppFontFamily}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextOnAccentBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,17,0,0">
                                <Button x:Name="HotkeyPill"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="34"
                                        Padding="9,0"
                                        Margin="0,0,8,8"
                                        Click="EditScenario_Click"
                                        ToolTip="{DynamicResource L_ChangeKeyTT}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconKeyboard}"
                                              Style="{StaticResource FillIcon}"
                                              Width="13"
                                              Height="13"
                                              Fill="{DynamicResource TextTertiaryBrush}"
                                              Margin="0,0,7,0" />
                                        <ItemsControl ItemsSource="{Binding SelectedScenario.HotkeyTokens}"
                                                      ItemTemplate="{StaticResource HotkeyTokenTemplate}"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <TextBlock Text="{DynamicResource L_AssignKey}"
                                                   FontFamily="{StaticResource AppFontFamily}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedScenario.HasHotkey}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Path Data="{StaticResource IconAlert}"
                                              Style="{StaticResource LineIcon}"
                                              Width="12"
                                              Height="12"
                                              Stroke="{DynamicResource WarningBrush}"
                                              Margin="6,0,0,0"
                                              Visibility="{Binding SelectedScenario.HasHotkeyError, Converter={StaticResource BoolToVisibility}}"
                                              ToolTip="{Binding SelectedScenario.HotkeyError}" />
                                    </StackPanel>
                                </Button>

                                <Border Style="{StaticResource Chip}"
                                        Height="34"
                                        Padding="10,0"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconWindow}"
                                              Style="{StaticResource LineIcon}"
                                              Width="12"
                                              Height="12"
                                              Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding SelectedScenario.ActionsSummary}"
                                                   Style="{StaticResource ChipText}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Chip}"
                                        Height="34"
                                        Padding="10,0"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource L_ScenarioActive}"
                                                   Style="{StaticResource ChipText}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <CheckBox Style="{StaticResource Switch}"
                                                  IsChecked="{Binding SelectedScenario.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{DynamicResource L_ScenarioActiveTT}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Border Style="{StaticResource Card}"
                                    Padding="0"
                                    Margin="0,9,0,0">
                                <StackPanel>
                                    <Grid Margin="22,17,16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource L_ActionsTitle}"
                                                       Style="{StaticResource TextSectionTitle}" />
                                            <Border Style="{StaticResource Chip}"
                                                    Margin="9,0,0,0"
                                                    Padding="7,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedScenario.ActionCount}"
                                                           Style="{StaticResource ChipText}"
                                                           FontSize="10" />
                                            </Border>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource SecondaryButton}"
                                                Height="32"
                                                Padding="10,0"
                                                Click="AddAction_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconPlus}"
                                                      Style="{StaticResource LineIcon}"
                                                      Width="12"
                                                      Height="12"
                                                      Margin="0,0,6,0"
                                                      StrokeThickness="1.8" />
                                                <TextBlock Text="{DynamicResource L_AddAction}"
                                                           FontFamily="{StaticResource AppFontFamily}"
                                                           FontSize="11.5"
                                                           FontWeight="Medium" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />

                                    <Border Style="{StaticResource InsetCard}"
                                            Margin="18,16,18,18"
                                            Padding="26,28"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            Visibility="{Binding SelectedScenario.HasActions, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="50"
                                                    Height="50"
                                                    CornerRadius="0"
                                                    Background="{Binding SelectedScenario.AccentSoftBrush}"
                                                    HorizontalAlignment="Center">
                                                <Path Data="{StaticResource IconBolt}"
                                                      Width="21"
                                                      Height="21"
                                                      Fill="{Binding SelectedScenario.AccentBrush}"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{DynamicResource L_NoActionsTitle}"
                                                       Style="{StaticResource TextCardTitle}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,14,0,0" />
                                            <TextBlock Text="{DynamicResource L_NoActionsText}"
                                                       Style="{StaticResource TextSecondary}"
                                                       MaxWidth="360"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       LineHeight="19"
                                                       Margin="0,5,0,0" />
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    MinWidth="173"
                                                    Margin="0,15,0,0"
                                                    HorizontalAlignment="Center"
                                                    Click="AddAction_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconPlus}"
                                                          Style="{StaticResource LineIcon}"
                                                          Width="12"
                                                          Height="12"
                                                          Margin="0,0,6,0"
                                                          StrokeThickness="1.8" />
                                                    <TextBlock Text="{DynamicResource L_AddFirstAction}"
                                                               FontFamily="{StaticResource AppFontFamily}"
                                                               FontSize="12"
                                                               FontWeight="Medium" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding SelectedScenario.Actions}"
                                                  ItemTemplate="{StaticResource ActionTemplate}"
                                                  Margin="8,7,8,8"
                                                  Visibility="{Binding SelectedScenario.HasActions, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <Border Height="1"
                                            Background="{DynamicResource DividerBrush}"
                                            Visibility="{Binding SelectedScenario.HasActions, Converter={StaticResource BoolToVisibility}}" />

                                    <Grid Margin="22,11,22,11"
                                          Visibility="{Binding SelectedScenario.HasActions, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconClock}"
                                                  Style="{StaticResource LineIcon}"
                                                  Width="11"
                                                  Height="11"
                                                  Stroke="{DynamicResource TextTertiaryBrush}"
                                                  StrokeThickness="1.8"
                                                  Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding SelectedScenario.LastRunLabel}"
                                                       FontFamily="{StaticResource AppFontFamily}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource L_RunTopToBottom}"
                                                   FontFamily="{StaticResource AppFontFamily}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsScrollViewer"
                              Style="{StaticResource PageScrollViewer}"
                              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="34,20,34,30" MaxWidth="820" HorizontalAlignment="Left">
                        <Button Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left"
                                Padding="0,0,10,0"
                                Height="30"
                                Click="BackToScenarios_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconChevronLeft}"
                                      Style="{StaticResource LineIcon}"
                                      Width="12"
                                      Height="12"
                                      Margin="0,0,5,0" />
                                <TextBlock Text="{DynamicResource L_BackToScenarios}"
                                           FontFamily="{StaticResource AppFontFamily}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{DynamicResource L_SettingsTitle}"
                                   Style="{StaticResource TextPageTitle}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{DynamicResource L_SettingsSub}"
                                   Style="{StaticResource TextSecondary}"
                                   Margin="0,4,0,0" />

                        <TextBlock Text="{DynamicResource L_SectGeneral}"
                                   Style="{StaticResource TextSectionLabel}"
                                   Margin="2,26,0,9" />
                        <Border Style="{StaticResource Card}" Padding="0">
                            <StackPanel>
                                <Grid Margin="18,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingIconTile}">
                                        <Path Data="{StaticResource IconPower}"
                                              Style="{StaticResource LineIcon}"
                                              Width="16"
                                              Height="16"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L_SetStartTitle}" Style="{StaticResource TextValue}" />
                                        <TextBlock Text="{DynamicResource L_SetStartDesc}"
                                                   Style="{StaticResource TextCaption}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2"
                                              Style="{StaticResource Switch}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Preferences.StartWithWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{DynamicResource L_SetStartTT}" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="66,0,18,0" />

                                <Grid Margin="18,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingIconTile}">
                                        <Path Data="{StaticResource IconTray}"
                                              Style="{StaticResource LineIcon}"
                                              Width="16"
                                              Height="16"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L_SetTrayTitle}" Style="{StaticResource TextValue}" />
                                        <TextBlock Text="{DynamicResource L_SetTrayDesc}"
                                                   Style="{StaticResource TextCaption}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2"
                                              Style="{StaticResource Switch}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Preferences.MinimizeToTray, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{DynamicResource L_SetTrayTT}" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="66,0,18,0" />

                                <Grid Margin="18,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingIconTile}">
                                        <Path Data="{StaticResource IconBell}"
                                              Style="{StaticResource LineIcon}"
                                              Width="16"
                                              Height="16"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L_SetNotifyTitle}" Style="{StaticResource TextValue}" />
                                        <TextBlock Text="{DynamicResource L_SetNotifyDesc}"
                                                   Style="{StaticResource TextCaption}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2"
                                              Style="{StaticResource Switch}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Preferences.ShowNotifications, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{DynamicResource L_SetNotifyTT}" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="66,0,18,0" />

                                <Grid Margin="18,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingIconTile}">
                                        <Path Data="{StaticResource IconKeyboard}"
                                              Style="{StaticResource FillIcon}"
                                              Width="16"
                                              Height="16"
                                              Fill="{DynamicResource TextSecondaryBrush}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L_SetHotkeysTitle}" Style="{StaticResource TextValue}" />
                                        <TextBlock Text="{DynamicResource L_SetHotkeysDesc}"
                                                   Style="{StaticResource TextCaption}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2"
                                              Style="{StaticResource Switch}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Preferences.HotkeysEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{DynamicResource L_SetHotkeysTT}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource L_SectAppearance}"
                                   Style="{StaticResource TextSectionLabel}"
                                   Margin="2,22,0,9" />
                        <Border Style="{StaticResource Card}" Padding="0">
                            <Grid Margin="18,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SettingIconTile}">
                                    <Path Data="{StaticResource IconMoon}"
                                          Style="{StaticResource LineIcon}"
                                          Width="16"
                                          Height="16"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource L_SetDarkTitle}" Style="{StaticResource TextValue}" />
                                    <TextBlock Text="{DynamicResource L_SetDarkDesc}"
                                               Style="{StaticResource TextCaption}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="2"
                                          Style="{StaticResource Switch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Preferences.UseDarkTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="{DynamicResource L_SetDarkTT}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{DynamicResource L_SectLanguage}"
                                   Style="{StaticResource TextSectionLabel}"
                                   Margin="2,22,0,9" />
                        <Border Style="{StaticResource Card}" Padding="0">
                            <Grid Margin="18,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SettingIconTile}">
                                    <Path Data="{StaticResource IconExternal}"
                                          Style="{StaticResource LineIcon}"
                                          Width="16"
                                          Height="16"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource L_SetLangTitle}" Style="{StaticResource TextValue}" />
                                    <TextBlock Text="{DynamicResource L_SetLangDesc}"
                                               Style="{StaticResource TextCaption}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="LanguageEnChoice"
                                                 GroupName="InterfaceLanguage"
                                                 Style="{StaticResource ChoiceCard}"
                                                 Content="{DynamicResource L_LangEn}"
                                                 Margin="0,0,5,0"
                                                 Checked="LanguageChoice_Checked" />
                                    <RadioButton x:Name="LanguageRuChoice"
                                                 GroupName="InterfaceLanguage"
                                                 Style="{StaticResource ChoiceCard}"
                                                 Content="{DynamicResource L_LangRu}"
                                                 Margin="5,0,0,0"
                                                 Checked="LanguageChoice_Checked" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="{DynamicResource L_SectData}"
                                   Style="{StaticResource TextSectionLabel}"
                                   Margin="2,22,0,9" />
                        <Border Style="{StaticResource Card}" Padding="0">
                            <Grid Margin="18,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SettingIconTile}">
                                    <Path Data="{StaticResource IconFolder}"
                                          Style="{StaticResource LineIcon}"
                                          Width="16"
                                          Height="16"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource L_SetDataTitle}" Style="{StaticResource TextValue}" />
                                    <TextBlock x:Name="DataFolderPath"
                                               Style="{StaticResource TextCaption}"
                                               Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="32"
                                        Padding="11,0"
                                        VerticalAlignment="Center"
                                        Click="OpenDataFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconExternal}"
                                              Style="{StaticResource LineIcon}"
                                              Width="12"
                                              Height="12"
                                              Margin="0,0,6,0"
                                              StrokeThickness="1.7" />
                                        <TextBlock Text="{DynamicResource L_DataOpen}"
                                                   FontFamily="{StaticResource AppFontFamily}"
                                                   FontSize="11.5"
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Text="{DynamicResource L_SectLinks}"
                                   Style="{StaticResource TextSectionLabel}"
                                   Margin="2,22,0,9" />
                        <Border Style="{StaticResource Card}" Padding="10">
                            <StackPanel>
                                <Button Style="{StaticResource LinkRowButton}"
                                        Click="OpenLink_Click"
                                        Tag="https://github.com/wintence/scenario22"
                                        ToolTip="github.com/wintence/scenario22">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SettingIconTile}">
                                            <Path Data="{StaticResource IconExternal}"
                                                  Style="{StaticResource LineIcon}"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="GitHub" Style="{StaticResource TextValue}" />
                                            <TextBlock Text="github.com/wintence/scenario22"
                                                       Style="{StaticResource TextCaption}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="48,2" />
                                <Button Style="{StaticResource LinkRowButton}"
                                        Click="OpenLink_Click"
                                        Tag="https://t.me/devtence"
                                        ToolTip="t.me/devtence">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SettingIconTile}">
                                            <Path Data="{StaticResource IconExternal}"
                                                  Style="{StaticResource LineIcon}"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Telegram" Style="{StaticResource TextValue}" />
                                            <TextBlock Text="t.me/devtence"
                                                       Style="{StaticResource TextCaption}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid x:Name="OverlayLayer"
              Grid.RowSpan="2"
              Panel.ZIndex="100"
              Background="{DynamicResource OverlayBrush}"
              Visibility="Collapsed"
              Opacity="0">
            <ContentControl x:Name="SheetHost"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="SheetTranslate" Y="14" />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
