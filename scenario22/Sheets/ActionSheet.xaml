<UserControl x:Class="Scenario22.Sheets.ActionSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <Border Width="540"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="44"
                              Direction="270"
                              Opacity="0.28"
                              ShadowDepth="12"
                              Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="26,24,26,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource TextSheetTitle}"
                               Text="{DynamicResource L_NewActionTitle}" />
                    <TextBlock x:Name="SubtitleText"
                               Style="{StaticResource TextSecondary}"
                               Margin="0,3,0,0"
                               Text="{DynamicResource L_ActionSubtitle}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        ToolTip="{DynamicResource L_Cancel}"
                        Click="Cancel_Click"
                        VerticalAlignment="Top">
                    <Path Data="{StaticResource IconClose}"
                          Style="{StaticResource LineIcon}"
                          Width="15"
                          Height="15" />
                </Button>
            </Grid>

            <UniformGrid Columns="2" Margin="0,18,0,0">
                <RadioButton x:Name="LaunchChoice"
                             GroupName="ActionKind"
                             Style="{StaticResource ChoiceCard}"
                             Margin="0,0,5,0"
                             IsChecked="True"
                             Checked="ActionKind_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32"
                                Height="32"
                                CornerRadius="9"
                                Background="{DynamicResource LaunchChipBgBrush}">
                            <Path Data="{StaticResource IconArrowUpRight}"
                                  Style="{StaticResource LineIcon}"
                                  Width="15"
                                  Height="15"
                                  Stroke="{DynamicResource LaunchChipTextBrush}" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextValue}" Text="{DynamicResource L_KindLaunchT}" />
                            <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,0" Text="{DynamicResource L_KindLaunchS}" />
                        </StackPanel>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="CloseChoice"
                             GroupName="ActionKind"
                             Style="{StaticResource ChoiceCard}"
                             Margin="5,0,0,0"
                             Checked="ActionKind_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32"
                                Height="32"
                                CornerRadius="9"
                                Background="{DynamicResource CloseChipBgBrush}">
                            <Path Data="{StaticResource IconClose}"
                                  Style="{StaticResource LineIcon}"
                                  Width="14"
                                  Height="14"
                                  Stroke="{DynamicResource CloseChipTextBrush}" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextValue}" Text="{DynamicResource L_KindCloseT}" />
                            <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,0" Text="{DynamicResource L_KindCloseS}" />
                        </StackPanel>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <TextBlock Style="{StaticResource FormLabel}" Margin="0,16,0,7" Text="{DynamicResource L_Name}" />
            <TextBox x:Name="NameBox"
                     Style="{StaticResource InputTextBox}"
                     MaxLength="60"
                     Tag="{DynamicResource L_NamePhSteam}" />

            <StackPanel x:Name="LaunchPanel" Margin="0,13,0,0">
                <TextBlock Style="{StaticResource FormLabel}" Margin="0,0,0,7" Text="{DynamicResource L_TargetLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetBox"
                             Style="{StaticResource InputTextBox}"
                             Tag="{DynamicResource L_TargetPh}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Height="40"
                            MinWidth="86"
                            Margin="8,0,0,0"
                            Click="BrowseTarget_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}"
                                  Style="{StaticResource LineIcon}"
                                  Width="14"
                                  Height="14"
                                  Margin="0,0,6,0" />
                            <TextBlock FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Text="{DynamicResource L_Browse}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Style="{StaticResource FormHint}"
                           Text="{DynamicResource L_TargetHint}" />

                <TextBlock Style="{StaticResource FormLabel}" Margin="0,13,0,7" Text="{DynamicResource L_ArgumentsLabel}" />
                <TextBox x:Name="ArgumentsBox"
                         Style="{StaticResource InputTextBox}"
                         Tag="{DynamicResource L_ArgPh}" />
            </StackPanel>

            <StackPanel x:Name="ClosePanel" Margin="0,13,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FormLabel}" Margin="0,0,0,7" Text="{DynamicResource L_ProcessLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ProcessBox"
                             Style="{StaticResource InputTextBox}"
                             Tag="{DynamicResource L_ProcessPh}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Height="40"
                            MinWidth="86"
                            Margin="8,0,0,0"
                            Click="BrowseProcess_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconWindow}"
                                  Style="{StaticResource LineIcon}"
                                  Width="14"
                                  Height="14"
                                  Margin="0,0,6,0" />
                            <TextBlock FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Text="{DynamicResource L_ProcessPick}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Style="{StaticResource FormHint}"
                           Text="{DynamicResource L_ProcessHint}" />
            </StackPanel>

            <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextValue}" Text="{DynamicResource L_DelayLabel}" />
                    <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,0" Text="{DynamicResource L_DelayHint}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="DelayBox"
                             Style="{StaticResource InputTextBox}"
                             Width="64"
                             MaxLength="3"
                             Text="0"
                             TextAlignment="Center"
                             PreviewTextInput="DelayBox_PreviewTextInput" />
                    <TextBlock Style="{StaticResource TextSecondary}"
                               Margin="7,0,0,0"
                               Text="{DynamicResource L_Sec}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border x:Name="ErrorBanner"
                    Margin="0,13,0,0"
                    Padding="11,8"
                    Background="{DynamicResource DangerSoftBrush}"
                    CornerRadius="9"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource IconAlert}"
                          Style="{StaticResource LineIcon}"
                          Width="14"
                          Height="14"
                          Stroke="{DynamicResource DangerBrush}"
                          VerticalAlignment="Top"
                          Margin="0,1,7,0" />
                    <TextBlock x:Name="ErrorText"
                               Grid.Column="1"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="11.5"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        Content="{DynamicResource L_Cancel}"
                        Click="Cancel_Click" />
                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Style="{StaticResource PrimaryButton}"
                        Height="38"
                        MinWidth="118"
                        Content="{DynamicResource L_Add}"
                        Click="Save_Click" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
