<Window x:Class="Scenario22.Sheets.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scenario22"
        Width="472"
        Height="466"
        MinWidth="472"
        MaxWidth="472"
        MinHeight="466"
        MaxHeight="466"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="PickTab" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Margin="0,0,8,0"
                                Padding="12,8"
                                Background="{DynamicResource InputBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            Background="Transparent">
        <StackPanel Margin="22,18,22,18">

            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  Background="Transparent">
                <TextBlock Style="{StaticResource TextSheetTitle}"
                           Text="{DynamicResource L_PickTitle}" />
                <Button Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right"
                        Margin="0,-6,-6,0"
                        ToolTip="{DynamicResource L_Cancel}"
                        Click="Close_Click">
                    <Path Data="{StaticResource IconClose}"
                          Style="{StaticResource LineIcon}"
                          Width="14"
                          Height="14" />
                </Button>
            </Grid>

            <!-- From / To swatch tabs -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <ToggleButton x:Name="FromTab"
                              Style="{StaticResource PickTab}"
                              Click="FromTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle x:Name="FromSwatch"
                                   Width="16"
                                   Height="16"
                                   Stroke="{DynamicResource CardBorderStrongBrush}"
                                   StrokeThickness="1" />
                        <TextBlock x:Name="FromTabLabel"
                                   Margin="8,0,0,0"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ToTab"
                              Style="{StaticResource PickTab}"
                              Click="ToTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle x:Name="ToSwatch"
                                   Width="16"
                                   Height="16"
                                   Stroke="{DynamicResource CardBorderStrongBrush}"
                                   StrokeThickness="1" />
                        <TextBlock x:Name="ToTabLabel"
                                   Margin="8,0,0,0"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <!-- Saturation / brightness field and hue slider -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Canvas x:Name="SvCanvas"
                        Width="380"
                        Height="190"
                        Cursor="Cross"
                        ClipToBounds="True"
                        Background="Transparent"
                        MouseLeftButtonDown="SvCanvas_MouseLeftButtonDown"
                        MouseMove="SvCanvas_MouseMove"
                        MouseLeftButtonUp="SvCanvas_MouseLeftButtonUp">
                    <Rectangle x:Name="SvHueFill"
                               Width="380"
                               Height="190"
                               Canvas.Left="0"
                               Canvas.Top="0" />
                    <Rectangle x:Name="SvShade"
                               Width="380"
                               Height="190"
                               Canvas.Left="0"
                               Canvas.Top="0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#FF000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas x:Name="SvPointer" IsHitTestVisible="False">
                        <Ellipse Width="18"
                                 Height="18"
                                 Canvas.Left="1"
                                 Canvas.Top="1"
                                 Stroke="#99000000"
                                 StrokeThickness="1.5" />
                        <Ellipse Width="14"
                                 Height="14"
                                 Canvas.Left="3"
                                 Canvas.Top="3"
                                 Stroke="White"
                                 StrokeThickness="1.75" />
                    </Canvas>
                </Canvas>

                <Canvas x:Name="HueCanvas"
                        Grid.Column="1"
                        Width="24"
                        Height="190"
                        Margin="14,0,0,0"
                        Cursor="Hand"
                        MouseLeftButtonDown="HueCanvas_MouseLeftButtonDown"
                        MouseMove="HueCanvas_MouseMove"
                        MouseLeftButtonUp="SvCanvas_MouseLeftButtonUp">
                    <Rectangle x:Name="HueFill"
                               Width="24"
                               Height="190"
                               Canvas.Left="0"
                               Canvas.Top="0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFF0000" Offset="0" />
                                <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                                <GradientStop Color="#FF00FF00" Offset="0.3333" />
                                <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                <GradientStop Color="#FF0000FF" Offset="0.6667" />
                                <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                                <GradientStop Color="#FFFF0000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas x:Name="HueThumb" IsHitTestVisible="False">
                        <Rectangle Width="36"
                                   Height="20"
                                   Stroke="White"
                                   StrokeThickness="1.5" />
                        <Rectangle Width="32"
                                   Height="16"
                                   Canvas.Left="2"
                                   Canvas.Top="2"
                                   Stroke="#99000000"
                                   StrokeThickness="1.5" />
                    </Canvas>
                </Canvas>
            </Grid>

            <!-- HEX input and live gradient preview -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="HEX"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource AppFontFamily}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="HexBox"
                         Grid.Column="1"
                         Style="{StaticResource InputTextBox}"
                         Height="34"
                         MinHeight="34"
                         FontSize="12.5"
                         ToolTip="{DynamicResource L_PickHexTT}"
                         TextChanged="HexBox_TextChanged" />
                <Border x:Name="PreviewBorder"
                        Grid.Column="2"
                        Height="34"
                        Margin="10,0,0,0"
                        BorderBrush="{DynamicResource CardBorderStrongBrush}"
                        BorderThickness="1" />
            </Grid>

            <Grid Margin="0,18,0,0">
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}"
                            MinWidth="92"
                            Content="{DynamicResource L_Cancel}"
                            Click="Close_Click" />
                    <Button Style="{StaticResource PrimaryButton}"
                            MinWidth="112"
                            Margin="8,0,0,0"
                            Content="{DynamicResource L_Save}"
                            Click="Save_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
