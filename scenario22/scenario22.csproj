<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Scenario22</AssemblyName>
    <RootNamespace>Scenario22</RootNamespace>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>Scenario22</Product>
    <Description>Сценарии запуска приложений одним нажатием</Description>
    <Company>Scenario22</Company>
    <Copyright>© 2026 Scenario22</Copyright>
    <Platforms>x64</Platforms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\app-preview.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\LICENSE.txt" />
  </ItemGroup>

</Project>
